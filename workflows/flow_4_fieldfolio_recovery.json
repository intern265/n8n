    {
      "id": "19856896-954c-4403-a4c1-b73f05f5a895",
      "name": "Evaluate Eligibility",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 304],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const trackerItems = $input.all();\nconst trackerRows = trackerItems\n  .map(item => item.json)\n  .filter(row => row.AccountNo || row.accountNo);\n\nconst customers = $('Normalize Customer').all();\nconst results = [];\nconst now = new Date();\nconst maxSteps = 3;\n\nfor (const custItem of customers) {\n  const customer = custItem.json;\n  const daysCooldown = Number(customer.daysCooldown) || 7;\n  const custAccountNo = String(customer.accountNo ?? '').trim().toLowerCase();\n\n  const tracker = trackerRows.find(row => {\n    const rowAcct = String(row.AccountNo ?? row.accountNo ?? '').trim().toLowerCase();\n    return rowAcct === custAccountNo;\n  }) || {};\n\n  const accountNo = String(tracker.AccountNo ?? tracker.accountNo ?? '').trim();\n  const flow = String(tracker.Flow ?? tracker.flow ?? '').trim();\n  const status = String(tracker.Status ?? tracker.status ?? '').trim();\n  const step = Number(tracker.Step ?? tracker.step ?? 0);\n\n  const lastEmailRaw = tracker.LastEmailSent ?? tracker.lastEmailSent ?? '';\n  let lastEmailSent = null;\n  if (lastEmailRaw) {\n    const parsedDate = new Date(lastEmailRaw);\n    if (!isNaN(parsedDate.getTime())) {\n      lastEmailSent = parsedDate;\n    }\n  }\n\n  const trackerFound = Boolean(accountNo || flow);\n  const daysSinceEmail = lastEmailSent ? (now - lastEmailSent) / 86400000 : Infinity;\n  const inCooldown = lastEmailSent !== null && daysSinceEmail < daysCooldown;\n  const normalizedStatus = status.toLowerCase();\n  const terminal = normalizedStatus === 'converted' || normalizedStatus === 'escalated';\n\n  let eligible = false;\n  let nextStep = step;\n  let nextStatus = status || 'Active';\n  let reason = '';\n\n  if (!trackerFound) {\n    eligible = true;\n    nextStep = 1;\n    nextStatus = 'Active';\n    reason = 'new-entry';\n  } else if (terminal) {\n    eligible = false;\n    nextStep = step;\n    nextStatus = status;\n    reason = 'terminal-status';\n  } else if (step >= maxSteps) {\n    eligible = false;\n    nextStep = step;\n    nextStatus = 'Unresponsive';\n    reason = 'max-steps-reached';\n  } else if (inCooldown) {\n    eligible = false;\n    nextStep = step;\n    nextStatus = status || 'Active';\n    reason = 'in-cooldown';\n  } else {\n    eligible = true;\n    nextStep = step + 1;\n    nextStatus = 'Active';\n    reason = 'due-for-next-email';\n  }\n\n  results.push({\n    json: {\n      ...customer,\n      eligible,\n      reason,\n      trackerFound,\n      trackerAccountNo: accountNo,\n      currentStep: step,\n      nextStep,\n      nextStatus,\n      trackerStatus: status || null,\n      trackerFlow: flow || null,\n      lastEmailSent: lastEmailSent ? lastEmailSent.toISOString() : null,\n      daysSinceEmail: lastEmailSent ? Math.round(daysSinceEmail * 100) / 100 : null,\n      daysCooldown,\n      nowISO: now.toISOString()\n    }\n  });\n}\n\nreturn results;"
      }
    },
